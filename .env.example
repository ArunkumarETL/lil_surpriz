# Public site URL (used for SEO, sitemap and Cashfree return URLs)
NEXT_PUBLIC_SITE_URL=https://www.lilsurpriz.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only – never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Cashfree Payment Gateway (merchant.cashfree.com → Developers → API Keys)
# "sandbox" for test mode, "production" for live payments. Server only.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
